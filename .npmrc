# O vitest 4 declara um punhado de peers opcionais (@vitest/browser-*, msw) e o
# npm 10 estoura ao resolvê-los: "Cannot read properties of null (reading
# 'edgesOut')" — bug do arborist, não do projeto. Com isto `npm install` roda
# limpo aqui e no Netlify, sem ninguém precisar lembrar de uma flag.
legacy-peer-deps=true
